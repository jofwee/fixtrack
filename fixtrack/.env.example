# Copy to .env.local. Only these two public values belong in Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# One-time local setup only. NEVER prefix these private values with VITE_.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY (use one, not both).
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL; set after Vercel assigns the preview domain.
APP_URL=
# Optional comma-separated extra exact origins, e.g. http://127.0.0.1:5173
ALLOWED_ORIGINS=
